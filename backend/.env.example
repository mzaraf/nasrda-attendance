# Core application
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
ALLOWED_HOSTS=attendance.bots.ng
CSRF_TRUSTED_ORIGINS=https://attendance.bots.ng

# PostgreSQL
DB_NAME=nasrda_attendance
DB_USER=nasrda_attendance
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Biometric device registration (must exactly match the public HTTPS domain)
WEBAUTHN_RP_ID=attendance.bots.ng
WEBAUTHN_ORIGIN=https://attendance.bots.ng

# SMTP email (optional). When these are absent or invalid, the attendance system continues normally.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=NASRDA Staff Attendance <no-reply@example.com>
