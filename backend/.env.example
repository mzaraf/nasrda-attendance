# Core application
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
ALLOWED_HOSTS=attendance.bots.ng
CSRF_TRUSTED_ORIGINS=https://attendance.bots.ng

# PostgreSQL
DB_NAME=nasrda_attendance
DB_USER=nasrda_attendance
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Shared cache table for short-lived attendance challenges
DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
DJANGO_CACHE_LOCATION=django_cache

# Self-hosted facial verification. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_KEY=replace-with-a-fernet-key
# Calibrate during the pilot; lower is stricter for cosine distance.
FACE_MATCH_THRESHOLD=0.35

# SMTP email (optional). When these are absent or invalid, the attendance system continues normally.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=NASRDA Staff Attendance <no-reply@example.com>

